[Unit]
Description=DEFNETT collector + dashboard :8090
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=defnett
Group=defnett
EnvironmentFile=/etc/defnett/collector.env
ExecStart=/usr/bin/python3 /opt/defnett/collector.py
Restart=always
RestartSec=2
# hardening padanan compose: read_only, cap_drop ALL, no-new-privileges, tmpfs
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/evidence

[Install]
WantedBy=multi-user.target
