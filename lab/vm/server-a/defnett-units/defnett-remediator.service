[Unit]
Description=DEFNETT remediator server-a :8091
After=network-online.target server-a.netplan-ready.target
Wants=network-online.target

[Service]
Type=simple
User=defnett
Group=defnett
EnvironmentFile=/etc/defnett/server-a.env
ExecStart=/usr/bin/python3 /opt/defnett/remediator.py
Restart=always
RestartSec=2
# hardening padanan compose: read_only, cap_drop ALL, no-new-privileges, tmpfs
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/data /master /quarantine

[Install]
WantedBy=multi-user.target
